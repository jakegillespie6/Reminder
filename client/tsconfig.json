{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "rootDir": ".",
    "paths": {
      "@lib/*": ["./src/lib/*"],
      "@features/*": ["./src/features/*"],
      "@components/*": ["./src/components/*"],
      "@store/*": ["./src/store/*"]
    }
  }
}
